# ============================================
# DefaultTaste — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# REQUIRED: Google Gemini API Key
# Claim hackathon credits FIRST: https://trygcp.dev/claim/sg-hack-mar7
# Then get key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================
# Optional overrides
# ============================================

# Gemini model for website probing + analysis
# GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Number of website generation runs
# WEBSITE_PROBE_COUNT=100

# Number of music generation runs
# MUSIC_PROBE_COUNT=20
